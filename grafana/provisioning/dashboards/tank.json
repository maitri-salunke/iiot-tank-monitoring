  {
   "id": 1,
   "title": "Tank level LT-101 vs setpoint (SIMULATED plant)",
   "type": "timeseries",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"iiot\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tank\" and (r._field == \"level_pct\" or r._field == \"sp_pct\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
    }
   ],
   "options": {},
   "description": "Level from the Python tank model, controlled by the ST PID running in OpenPLC."
  },
